# ---- server ----
PORT=3000
SESSION_SECRET=change-me-to-64-random-hex-chars
# comma separated origins allowed to send credentials (dev only; prod is same-origin)
CORS_ORIGIN=http://localhost:5173

# ---- database ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cloudtunes
DB_PASS=cloudtunes
DB_NAME=cloudtunes
# set to the RDS CA bundle path in production to force TLS, leave empty locally
DB_SSL_CA=

# ---- storage ----
# "local" writes to packages/backend/storage/, "s3" uses the bucket below
STORAGE_DRIVER=s3
LOCAL_STORAGE_DIR=./storage
S3_BUCKET=cloudtunes
AWS_REGION=us-east-2

# Local development points at MinIO (docker compose). On EC2 leave S3_ENDPOINT
# and both keys EMPTY: the SDK then uses the instance's IAM role against real S3.
S3_ENDPOINT=http://127.0.0.1:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# ---- uploads ----
MAX_UPLOAD_MB=30
